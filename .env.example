# The deployed ProofOfLifeVault contract address on GenLayer.
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Which GenLayer network to talk to: studionet | localnet | testnetAsimov | testnetBradbury
VITE_GENLAYER_NETWORK=studionet

# Only used when VITE_GENLAYER_NETWORK=localnet, to point at a local GenLayer node.
VITE_LOCALNET_RPC_URL=http://127.0.0.1:4000/api
